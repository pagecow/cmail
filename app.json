{
  "id": "com.cmail.app",
  "name": "Cmail",
  "version": "0.4.1",
  "description": "Read, send, star, archive, and trash mail from your own Gmail account.",
  "icon": "icon.svg",
  "capabilities": ["hostHttp", "secrets", "openExternal", "clipboardRead", "clipboardWrite", "drive"],
  "httpAllowlist": ["gmail.googleapis.com", "oauth2.googleapis.com"],
  "openExternalAllowlist": ["accounts.google.com"],
  "scopedDataKeys": ["cmail.state"]
}
